# Auto detect text files and use LF on checkin
* text=auto

# Python source files
*.py text eol=lf diff=python

# Shell scripts
*.sh text eol=lf

# Web files
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf diff=javascript
*.json text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
